<MvFUNCTION NAME = "PaymentModule_Order_Delete" PARAMETERS = "data VAR,secure_data VAR" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">
	<MvIF EXPR = "{ l.ok }">
		<MvFIND NAME = "PlugNPayOrders" VALUE = "{ Orders.d.id }" EXACT>
		<MvIF EXPR = "{ NOT PlugNPayOrders.d.EOF }">
			<MvDELETE NAME = "PlugNPayOrders">
		</MvIF>

		<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.ok }">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Order_Tabs" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "PLUGNPAY:Plug & Pay Technologies Inc. v1.0">
</MvFUNCTION>


<MvFUNCTION NAME = "PaymentModule_Order_Content" PARAMETERS = "tab, load_fields,data,secure_data" STANDARDOUTPUTLEVEL = "text, html, compresswhitespace">
	<MvASSIGN NAME = "l.ok" VALUE = 1>

	<MvIF EXPR = "{ l.tab EQ 'PLUGNPAY' }">
		<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">
		<MvIF EXPR = "{ l.ok }">
			<MvFIND NAME = "PlugNPayOrders" VALUE = "{ Orders.d.id }" EXACT>
			<MvIF EXPR = "{ NOT PlugNPayOrders.d.EOF }">
				<TABLE BORDER = 0 CELLPADDING = 2 CELLSPACING = 0 WIDTH = "100%">

				<TR><TD NOWRAP>
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<B>Method:</B>
					</FONT>
				</TD><TD WIDTH = "100%">
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<MvEVAL EXPR = "{ PlugNPayOrders.d.method }">
					</FONT>
				</TD></TR>

				<MvIF EXPR = "{ PlugNPayOrders.d.method EQ 'CC' }">
					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Name on Card:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.cc_name  }">
						</FONT>
					</TD></TR>

					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Card Number:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.card_num }">
						</FONT>
					</TD></TR>

					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Expiration:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.exp_date }">
						</FONT>
					</TD></TR>
					
					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Card CVV2 Number:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.card_cvv}">
						</FONT>
					</TD></TR>
					
					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>CVV2 Response :</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.cvvresp}">
						</FONT>
					</TD></TR>
					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>AVS Code:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.avs_code }">
						</FONT>
					</TD></TR>
				</MvIF>
				<MvIF EXPR = "{ PlugNPayOrders.d.method EQ 'ECHECK' }">
					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Bank Name:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.bank_name }">
						</FONT>
					</TD></TR>

					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Bank ABA Code:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.aba_code }">
						</FONT>
					</TD></TR>
					
					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Check Number:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.check_num}">
						</FONT>
					</TD></TR>
					

					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Account Number:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.acct_num }">
						</FONT>
					</TD></TR>

					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Account Type:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.acct_type }">
						</FONT>
					</TD></TR>
				</MvIF>

				<MvIF EXPR = "{ PlugNPayOrders.d.method EQ 'MOCPAY' }">
					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Cell Phone:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.cell_phone}">
						</FONT>
					</TD></TR>
					
					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Mocapay Code:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.moc_code }">
						</FONT>
					</TD></TR>

					
				</MvIF>

				<MvIF EXPR = "{ PlugNPayOrders.d.method EQ 'GC' }">
					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Payment Type:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.gc_paytype }">
						</FONT>
					</TD></TR>
					
					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>GiftCard Number:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.gc_number}">
						</FONT>
					</TD></TR>
					
					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Name on Card:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.gc_name }">
						</FONT>
					</TD></TR>

					<MvIF EXPR = "{ PlugNPayOrders.d.gc_paytype EQ 'PARTIAL' }">

						<TR><TD NOWRAP>
							<FONT FACE = "Arial, Helvetica" SIZE = "-1">
							<B>Card Number:</B>
							</FONT>
						</TD><TD WIDTH = "100%">
							<FONT FACE = "Arial, Helvetica" SIZE = "-1">
							<MvEVAL EXPR = "{ PlugNPayOrders.d.card_num }">
							</FONT>
						</TD></TR>
	
						<TR><TD NOWRAP>
							<FONT FACE = "Arial, Helvetica" SIZE = "-1">
							<B>Expiration:</B>
							</FONT>
						</TD><TD WIDTH = "100%">
							<FONT FACE = "Arial, Helvetica" SIZE = "-1">
							<MvEVAL EXPR = "{ PlugNPayOrders.d.exp_date }">
							</FONT>
						</TD></TR>
					</MvIF>
				</MvIF>

				<TR><TD NOWRAP>
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<B>Transaction ID:</B>
					</FONT>
				</TD><TD WIDTH = "100%">
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<MvEVAL EXPR = "{ PlugNPayOrders.d.trans_id }">
					</FONT>
				</TD></TR>

				<TR><TD NOWRAP>
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<B>Response Reason Text:</B>
					</FONT>
				</TD><TD WIDTH = "100%">
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<MvEVAL EXPR = "{ PlugNPayOrders.d.r_r_text }">
					</FONT>
				</TD></TR>

				<TR><TD NOWRAP>
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<B>Authorization Code:</B>
					</FONT>
				</TD><TD WIDTH = "100%">
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<MvEVAL EXPR = "{ PlugNPayOrders.d.auth_code }">
					</FONT>
				</TD></TR>

				<TR><TD NOWRAP>
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<B>Authorization Date & Time:</B>
					</FONT>
				</TD><TD WIDTH = "100%">
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<MvEVAL EXPR = "{ padl( time_t_month( PlugNPayOrders.d.time, timezone() ), 2, '0') $ '/' $ padl( time_t_dayofmonth( PlugNPayOrders.d.time, timezone() ), 2, '0')
									$ '/' $ time_t_year( PlugNPayOrders.d.time, timezone() ) $ ' - ' $ padl( time_t_hour( PlugNPayOrders.d.time, timezone() ), 2, '0' )
									$ ':' $ padl( time_t_min( PlugNPayOrders.d.time, timezone() ), 2, '0' ) $ ':' $ padl( time_t_sec( PlugNPayOrders.d.time, timezone() ), 2, '0' )
									$ ' ' $ stm_zone }">
					</FONT>
				</TD></TR>
				</TABLE>

			</MvIF>

			<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
		</MvIF>
	</MvIF>
	<MvFUNCTIONRETURN VALUE = "{ l.ok }">
</MvFUNCTION>

