<MvFUNCTION NAME = "Module_Type" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "PAYMENT">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Code" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "plugnpay">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Name" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "Plug & Pay Technologies Inc. v1.0">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Provider" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "Miva Corporation">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_API_Version" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "2.1">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Version" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "2.11">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Install" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "1">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Upgrade" PARAMETERS = "version" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "1">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Upgrade_Store" PARAMETERS = "version">
	<MvASSIGN NAME = "l.ok" VALUE = "1">

	<MvIF EXPR = "{ l.version LT 2.01 }">
		<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">

		<MvASSIGN NAME = "l.directory" VALUE = "{ g.MerchantPath $ padl( Stores.d.id, 8, '0' ) $ '/plugnpay/' }">
		<MvIF EXPR = "{ l.ok }">
			<MvCREATE NAME = "NewPlugNPayOrders"
					  DATABASE = "{ l.directory $ 'neworder.dbf' }"
					  FIELDS = "order_id				NUMBER,
								r_r_text				CHAR( 128 ),
								auth_code				CHAR( 6 ),
								avs_code				CHAR( 1 ),
								trans_id				CHAR( 32 ),
								amount				NUMBER( 10.2 ),
								card_num				CHAR( 16 ),
								cc_name				CHAR( 64 ),
								exp_date				CHAR( 7 ),
								method				CHAR( 6 ),
								bank_name				CHAR( 32 ),
								acct_num				CHAR( 17 ),
								acct_type				CHAR( 8 ),
								aba_code				CHAR( 9 ),
								time					NUMBER ">

			<MvIF EXPR = "{ MvCREATE_Error }">
				<MvDO FILE = "{ g.Module_Library_Utilities }" NAME = "l.ok" VALUE = "{ Error( 'MER-ATH-00010', MvCREATE_Error $ ' during upgrade') }">
				<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
			</MvIF>
		</MvIF>

		<MvIF EXPR = "{ l.ok }">
			<MvGO NAME = "PlugNPayOrders" ROW = "top">
			<MvWHILE EXPR = "{ NOT PlugNPayOrders.d.EOF }">
				<MvASSIGN NAME = "NewPlugNPayOrders.d.order_id" VALUE = "{ PlugNPayOrders.d.order_id }">
				<MvASSIGN NAME = "NewPlugNPayOrders.d.r_r_text" VALUE = "{ PlugNPayOrders.d.r_r_text }">
				<MvASSIGN NAME = "NewPlugNPayOrders.d.auth_code" VALUE = "{ PlugNPayOrders.d.auth_code }">
				<MvASSIGN NAME = "NewPlugNPayOrders.d.avs_code" VALUE = "{ PlugNPayOrders.d.avs_code }">
				<MvASSIGN NAME = "NewPlugNPayOrders.d.trans_id" VALUE = "{ PlugNPayOrders.d.trans_id }">
				<MvASSIGN NAME = "NewPlugNPayOrders.d.amount" VALUE = "{ PlugNPayOrders.d.amount ROUND 2 }">
				<MvASSIGN NAME = "NewPlugNPayOrders.d.card_num" VALUE = "{ PlugNPayOrders.d.card_num }">
				<MvASSIGN NAME = "NewPlugNPayOrders.d.cc_name" VALUE = "{ PlugNPayOrders.d.cc_name }">
				<MvASSIGN NAME = "NewPlugNPayOrders.d.exp_date" VALUE = "{ PlugNPayOrders.d.exp_date }">
				<MvASSIGN NAME = "NewPlugNPayOrders.d.method" VALUE = "{ PlugNPayOrders.d.method }">
				<MvASSIGN NAME = "NewPlugNPayOrders.d.bank_name" VALUE = "{ PlugNPayOrders.d.bank_name }">
				<MvASSIGN NAME = "NewPlugNPayOrders.d.acct_num" VALUE = "{ PlugNPayOrders.d.acct_num }">
				<MvASSIGN NAME = "NewPlugNPayOrders.d.acct_type" VALUE = "{ PlugNPayOrders.d.acct_type }">
				<MvASSIGN NAME = "NewPlugNPayOrders.d.aba_code" VALUE = "{ PlugNPayOrders.d.aba_code }">
				<MvASSIGN NAME = "NewPlugNPayOrders.d.time" VALUE = "{ PlugNPayOrders.d.time }">
				<MvADD NAME = "NewPlugNPayOrders">
				<MvSKIP NAME = "PlugNPayOrders" ROWS = "1">
			</MvWHILE>
			<MvCLOSE NAME = "NewPlugNPayOrders">
			<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
		</MvIF>

		<MvIF EXPR = "{ l.ok }">
			<MvIF EXPR = "{ NOT frename( l.directory $ 'neworder.dbf', l.directory $ 'aunorder.dbf' ) }">
				<MvDO FILE = "{ g.Module_Library_Utilities }"  NAME = "l.ok" VALUE = "{ Error( 'MER-ATH-00012', 'Error renaming new files during upgrade.') }">
			</MvIF>
			<MvIF EXPR = "{ NOT fdelete( l.directory $ 'aunorder.mvx' ) }">
				<MvDO FILE = "{ g.Module_Library_Utilities"  NAME = "l.ok" VALUE = "{ Error( 'MER-ATH-00013', 'Error deleting aunorder.mvx during upgrade.' }">
			<MvELSE>
				<MvOPEN NAME = "PlugNPayOrders" DATABASE = "{ l.directory $ 'aunorder.dbf' }">
				<MvMAKEINDEX NAME = "PlugNPayOrders"
							 INDEXFILE = "{ l.directory $ 'aunorder.mvx' }"
							 EXPRESSION = "{ PlugNPayOrders.d.order_id }"
							 FLAGS = "unique, ascending">
				<MvIF EXPR = "{ MvMAKEINDEX_Error }">
					<MvDO FILE = "{ g.Module_Library_Utilities }" NAME = "l.ok" VALUE = "{ Error( 'MER-ATH-00011', MvMAKEINDEX_Error $ ' during upgrade' ) }">
				<MvELSE>
					<MvCLOSE NAME = "PlugNPayOrders">
				</MvIF>
			</MvIF>
		</MvIF>
	</MvIF>
	
	<MvFUNCTIONRETURN VALUE = "{ l.ok }">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Uninstall" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "1">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Install_Store" STANDARDOUTPUTLEVEL = "" ERROROUTPUTLEVEL = "syntax, expression">
	<MvASSIGN NAME = "l.ok" VALUE = "1">

	<MvASSIGN NAME = "l.directory" VALUE = "{ g.MerchantPath $ padl( Stores.d.id, 8, '0' ) $ '/plugnpay/' }">
	<MvIF EXPR = "{ NOT fexists( l.directory ) }">
		<MvIF EXPR = "{ NOT fmkdir( l.directory ) }">
			<MvDO FILE = "{ g.Module_Library_Utilities }" NAME = "l.ok" VALUE = "{ Error( 'MER-ATH-00001', 'Unable to create directory \'' $ l.directory $ '\'' ) }">
		</MvIF>
	</MvIF>

	<MvIF EXPR = "{ l.ok }">
		<MvCREATE	NAME = "PlugNPay"
					DATABASE = "{ l.directory $ 'plugnpay.dbf' }"
					FIELDS = "merchant	CHAR( 100 ),
						    url		CHAR( 254 )">
		<MvIF EXPR = "{ MvCREATE_Error }">
			<MvDO FILE = "{ g.Module_Library_Utilities }" NAME = "l.ok" VALUE = "{ Error( 'MER-ATH-00002', MvCREATE_Error ) }">
		<MvELSE>
			<MvASSIGN NAME = "PlugNPay.d.merchant"	VALUE = "pnpdemo">
			<MvASSIGN NAME = "PlugNPay.d.url"		VALUE = "https://pay1.plugnpay.com/payment/pnpremote.cgi">
			<MvADD NAME = "PlugNPay">
		</MvIF>
	</MvIF>

	<MvIF EXPR = "{ l.ok }">
		<MvCREATE NAME = "PlugNPayMethods"
				  DATABASE = "{ l.directory $ 'authmeth.dbf' }"
				  FIELDS = "code	CHAR( 100 ),
							name	CHAR( 100 ),
							type	CHAR( 10 ),
							enabled BOOL">
		<MvIF EXPR = "{ MvCREATE_Error }">
			<MvDO FILE = "{ g.Module_Library_Utilities }" NAME = "l.ok" VALUE = "{ Error( 'MER-ATH-00003', MvCREATE_Error ) }">
		</MvIF>

		<MvIF EXPR = "{ l.ok }">
			<MvMAKEINDEX NAME = "PlugNPayMethods"
						 INDEXFILE = "{ l.directory $ 'authmeth.mvx' }"
						 EXPRESSION = "{ PlugNPayMethods.d.code }"
						 FLAGS = "unique, ascending">
			<MvIF EXPR = "{ MvMAKEINDEX_Error }">
				<MvDO FILE = "{ g.Module_Library_Utilities }" NAME = "l.ok" VALUE = "{ Error( 'MER-ATH-00004', MvMAKEINDEX_Error ) }">
			</MvIF>
		</MvIF>

		<MvIF EXPR = "{ l.ok }">
			<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPayMethods_Insert( 'Visa', 'Visa', 'CC', 1 ) }">
			<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPayMethods_Insert( 'MasterCard', 'MasterCard', 'CC', 1 ) }">
			<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPayMethods_Insert( 'Discover', 'Discover', 'CC', 1, ) }">
			<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPayMethods_Insert( 'AmerExp', 'American Express', 'CC', 1 ) }">
			<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPayMethods_Insert( 'ACH', 'Electronic Debit', 'ECHECK', 0 ) }">
		</MvIF>
	</MvIF>

	<MvIF EXPR = "{ l.ok }">
		<MvCREATE NAME = "PlugNPayOrders"
				  DATABASE = "{ l.directory $ 'aunorder.dbf' }"
				  FIELDS = "order_id				NUMBER,
							r_r_text				CHAR( 128 ),
							auth_code				CHAR( 6 ),
							avs_code				CHAR( 1 ),
							trans_id				CHAR( 32 ),
							amount				NUMBER( 10.2 ),
							card_num				CHAR( 16 ),
							cc_name				CHAR( 64 ),
							exp_date				CHAR( 7 ),
							method				CHAR( 6 ),
							bank_name				CHAR( 32 ),
							acct_num				CHAR( 17 ),
							acct_type				CHAR( 8 ),
							aba_code				CHAR( 9 ),
							time					NUMBER ">

		<MvIF EXPR = "{ MvCREATE_Error }">
			<MvDO FILE = "{ g.Module_Library_Utilities }" NAME = "l.ok" VALUE = "{ Error( 'MER-ATH-00005', MvCREATE_Error ) }">
		</MvIF>

		<MvIF EXPR = "{ l.ok }">
			<MvMAKEINDEX NAME = "PlugNPayOrders"
						 INDEXFILE = "{ l.directory $ 'aunorder.mvx' }"
						 EXPRESSION = "{ PlugNPayOrders.d.order_id }"
						 FLAGS = "unique, ascending">
			<MvIF EXPR = "{ MvMAKEINDEX_Error }">
				<MvDO FILE = "{ g.Module_Library_Utilities }" NAME = "l.ok" VALUE = "{ Error( 'MER-ATH-00006', MvMAKEINDEX_Error ) }">
			</MvIF>
		</MvIF>
	</MvIF>

	<MvIF EXPR = "{ l.ok }">
		<MvCLOSE NAME = "PlugNPay">
		<MvCLOSE NAME = "PlugNPayMethods">
		<MvCLOSE NAME = "PlugNPayOrders">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.ok }">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Pack_Store" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">
	<MvIF EXPR = "{ l.ok }">
		<MvPACK NAME = "PlugNPay">
		<MvPACK NAME = "PlugNPayMethods">
		<MvPACK NAME = "PlugNPayOrders">

		<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.ok }">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Uninstall_Store" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.directory" VALUE = "{ g.MerchantPath $ padl( Stores.d.id, 8, '0' ) $ '/plugnpay/' }">

	<MvASSIGN NAME = "l.ok" VALUE = "{ fdelete( l.directory $ 'plugnpay.dbf' ) }">
	<MvASSIGN NAME = "l.ok" VALUE = "{ fdelete( l.directory $ 'plugnpay.dbt' ) }">
	<MvASSIGN NAME = "l.ok" VALUE = "{ fdelete( l.directory $ 'authmeth.dbf' ) }">
	<MvASSIGN NAME = "l.ok" VALUE = "{ fdelete( l.directory $ 'authmeth.mvx' ) }">
	<MvASSIGN NAME = "l.ok" VALUE = "{ fdelete( l.directory $ 'aunorder.dbf' ) }">
	<MvASSIGN NAME = "l.ok" VALUE = "{ fdelete( l.directory $ 'aunorder.mvx' ) }">

	<MvASSIGN NAME = "l.ok" VALUE = "{ fdelete( l.directory ) }">

	<MvFUNCTIONRETURN VALUE = "1">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Is_Wizardable" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "1">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Wizard_Validate_Step" PARAMETERS = "step" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "g.Wizard_PlugNPay_merchant" VALUE = "{ ltrim( rtrim( g.Wizard_PlugNPay_merchant ) ) }">
	<MvIF EXPR = "{ l.step EQ 1 }">
		<MvIF EXPR = "{ len( g.Wizard_PlugNPay_merchant ) EQ 0 }">
			<MvDO FILE = "{ g.Module_Admin }" NAME = "l.valid" VALUE = "{ Wizard_Module_FieldError( l.step, 'Wizard_PlugNPay_merchant', 'Please specify a username' ) }">
			<MvFUNCTIONRETURN VALUE = "0">
		</MvIF>

	</MvIF>

	<MvIF EXPR = "{ l.step EQ 3 }">
		<MvASSIGN NAME = "l.found_enabled" VALUE = 0>
		<MvASSIGN NAME = "l.card" VALUE = 1>
		<MvWHILE EXPR = "{ l.card LE g.Wizard_PlugNPay_Method_Count }">
			<MvIF EXPR = "{ g.Wizard_PlugNPay_Method_Enabled_&[ l.card ] }">
				<MvASSIGN NAME = "l.found_enabled" VALUE = 1>
				<MvWHILESTOP>
			</MvIF>

			<MvASSIGN NAME = "l.card" VALUE = "{ l.card + 1 }">
		</MvWHILE>

		<MvIF EXPR = "{ NOT l.found_enabled }">
			<MvDO FILE = "{ g.Module_Admin }" NAME = "l.valid" VALUE = "{ Wizard_Module_FieldError( l.step, '', 'Please select at least one payment method' ) }">
			<MvFUNCTIONRETURN VALUE = 0>
		</MvIF>
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "1">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Wizard_Validate" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "g.Wizard_PlugNPay_merchant" VALUE = "{ ltrim( rtrim( g.Wizard_PlugNPay_merchant ) ) }">
	<MvIF EXPR = "{ len( g.Wizard_PlugNPay_merchant ) EQ 0 }">
		<MvDO FILE = "{ g.Module_Admin }" NAME = "l.valid" VALUE = "{ Wizard_Module_FieldError( 1, 'Wizard_PlugNPay_merchant', 'Please specify a username' ) }">
		<MvFUNCTIONRETURN VALUE = "0">
	</MvIF>

	<MvASSIGN NAME = "l.found_enabled" VALUE = 0>
	<MvASSIGN NAME = "l.card" VALUE = 1>
	<MvWHILE EXPR = "{ l.card LE g.Wizard_PlugNPay_Method_Count }">
		<MvIF EXPR = "{ g.Wizard_PlugNPay_Method_Enabled_&[ l.card ] }">
			<MvASSIGN NAME = "l.found_enabled" VALUE = 1>
			<MvWHILESTOP>
		</MvIF>

		<MvASSIGN NAME = "l.card" VALUE = "{ l.card + 1 }">
	</MvWHILE>

	<MvIF EXPR = "{ NOT l.found_enabled }">
		<MvDO FILE = "{ g.Module_Admin }" NAME = "l.valid" VALUE = "{ Wizard_Module_FieldError( 3, '', 'Please select at least one payment method' ) }">
		<MvFUNCTIONRETURN VALUE = 0>
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "1">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Wizard_Action" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">

	<MvIF EXPR = "{ l.ok }">
		<MvASSIGN NAME = "PlugNPay.d.merchant" VALUE = "{ g.Wizard_PlugNPay_merchant }">
		<MvASSIGN NAME = "PlugNPay.d.url"		VALUE = "https://pay1.plugnpay.com/payment/pnpremote.cgi">
		<MvUPDATE NAME = "PlugNPay">

		<MvASSIGN NAME = "l.card" VALUE = "1">
		<MvWHILE EXPR = "{ l.card LE g.Wizard_PlugNPay_Method_Count }">
			<MvFIND NAME = "PlugNPayMethods" VALUE = "{ g.Wizard_PlugNPay_Method_Code_&[ l.card ] }" EXACT>
			<MvIF EXPR = "{ NOT PlugNPayMethods.d.EOF }">
				<MvASSIGN NAME = "PlugNPayMethods.d.enabled" VALUE = "{ g.Wizard_PlugNPay_Method_Enabled_&[ l.card ] }">
				<MvUPDATE NAME = "PlugNPayMethods">
			</MvIF>

			<MvASSIGN NAME = "l.card" VALUE = "{ l.card + 1 }">
		</MvWHILE>

		<MvASSIGN NAME = "l.closed" VALUE = "{ PlugNPay_Close_Store() }">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.ok }">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Wizard_Content" PARAMETERS = "step, load_fields" STANDARDOUTPUTLEVEL = "text, html, compresswhitespace">
	<MvIF EXPR = "{ l.load_fields }">
		<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">
		<MvIF EXPR = "{ l.ok }">
			<MvASSIGN NAME = "g.Wizard_PlugNPay_merchant" VALUE = "{ PlugNPay.d.merchant }">

			<MvASSIGN NAME = "l.method" VALUE = "0">
			<MvGO NAME = "PlugNPayMethods" ROW = "top">
			<MvWHILE EXPR = "{ NOT PlugNPayMethods.d.EOF }">
				<MvASSIGN NAME = "l.method" VALUE = "{ l.method + 1 }">

				<MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Code_&[ l.method ]" VALUE = "{ PlugNPayMethods.d.code }">
				<MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Name_&[ l.method ]" VALUE = "{ PlugNPayMethods.d.name }">
				<MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Enabled_&[ l.method ]" VALUE = "{ PlugNPayMethods.d.enabled }">

				<MvSKIP NAME = "PlugNPayMethods" ROWS = "1">
			</MvWHILE>

			<MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Count" VALUE = "{ l.method }">

			<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
		<MvELSE>
			<MvASSIGN NAME = "g.Wizard_PlugNPay_merchant" VALUE = "">

			<MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Code_1" VALUE = "Visa"> <MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Name_1" VALUE = "Visa">				<MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Enabled_1" VALUE = "1">
			<MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Code_2" VALUE = "MasterCard"> <MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Name_2" VALUE = "MasterCard">		<MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Enabled_2" VALUE = "1">
			<MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Code_3" VALUE = "Discover"> <MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Name_3" VALUE = "Discover">			<MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Enabled_3" VALUE = "1">
			<MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Code_4" VALUE = "AmerExp"> <MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Name_4" VALUE = "American Express"> <MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Enabled_4" VALUE = "1">
			<MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Code_5" VALUE = "ACH"> <MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Name_5" VALUE = "Electronic Debit"> <MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Enabled_5" VALUE = "0">
			<MvASSIGN NAME = "g.Wizard_PlugNPay_Method_Count" VALUE = "5">
		</MvIF>
	</MvIF>

	<MvIF EXPR = "{ l.step EQ 1 }">
		<TABLE BORDER = 0 CELLPADDING = 2 CELLSPACING = 0 WIDTH = "100%">
		<TR><TD VALIGN = "top" ALIGN = "left" COLSPAN = 2>
			<FONT FACE = "Arial, Helvetica" SIZE = "-1">
			<P>
			PlugNPay Merchants are identified by a <I>Username</I>
                  This information is provided to you when your 
			PlugNPay account is created.
			</P>

			<P>
			Please enter your account information.
			</P>
			</FONT>
		</TD></TR>

		<TR><TD COLSPAN = 2>
			&nbsp;
		</TD></TR>

		<TR><TD NOWRAP>
			<FONT FACE = "Arial, Helvetica" SIZE = "-1">
			<B>Username:</B>
			</FONT>
		</TD><TD WIDTH = "100%">
			<FONT FACE = "Arial, Helvetica" SIZE = "-1">
			<INPUT TYPE = "text" SIZE = 40 NAME = "Wizard_PlugNPay_merchant" VALUE = "&[ g.Wizard_PlugNPay_merchant:entities ]">
			</FONT>
		</TD></TR>

		<TR><TD COLSPAN = 2>
			&nbsp;
		</TD></TR>

		<TR><TD VALIGN = "bottom" ALIGN = "left">
			<FONT FACE = "Arial, Helvetica" SIZE = "-1">
			<INPUT TYPE = "button" VALUE = "Previous" ONCLICK = "Module_Wizard_Previous();">
			</FONT>
		</TD><TD VALIGN = "bottom" ALIGN = "right">
			<FONT FACE = "Arial, Helvetica" SIZE = "-1">
			<INPUT TYPE = "button" VALUE = "Next" ONCLICK = "Module_Wizard_Next();">
			</FONT>
		</TD></TR>
		</TABLE>
	<MvELSE>
		<INPUT TYPE = "hidden" NAME = "Wizard_PlugNPay_merchant" VALUE = "&[ g.Wizard_PlugNPay_merchant:entities ]">
	</MvIF>

	<MvIF EXPR = "{ l.step EQ 2 }">
		<TABLE BORDER = 0 CELLPADDING = 2 CELLSPACING = 0 WIDTH = "100%">
		<TR><TD VALIGN = "top" ALIGN = "left" COLSPAN = 2>
			<FONT FACE = "Arial, Helvetica" SIZE = "-1">
			<P>
			Please select the credit cards you wish to accept.
			</P>
			</FONT>
		</TD></TR>

		<TR><TD COLSPAN = 2>
			&nbsp;
		</TD></TR>

		<TR><TD VALIGN = "top" NOWRAP>
			<FONT SIZE = "-1" FACE = "Arial, Helvetica">
			Available Payment Methods:
			</FONT>
		</TD><TD WIDTH = "100%">
			<TABLE BORDER = 0>
				<MvASSIGN NAME = "l.col" VALUE = 1>

				<TR>
				<MvASSIGN NAME = "l.method" VALUE = 1>
				<MvWHILE EXPR = "{ l.method LE g.Wizard_PlugNPay_Method_Count }">
					<MvASSIGN NAME = "l.method_code" VALUE = "{ g.Wizard_PlugNPay_Method_Code_&[ l.method ] }">
					<MvASSIGN NAME = "l.method_name" VALUE = "{ g.Wizard_PlugNPay_Method_Name_&[ l.method ] }">

					<MvIF EXPR = "{ l.col GT 2 }">
						<MvASSIGN NAME = "l.col" VALUE = 1>
						</TR><TR>
					</MvIF>

					<TD ALIGN = "left" VALIGN = "middle" NOWRAP>
						<FONT SIZE = "-1" FACE = "Arial, Helvetica">
						<INPUT TYPE = "hidden" NAME = "Wizard_PlugNPay_Method_Code_&[ l.method ]" VALUE = "&[ l.method_code:entities ]">
						<INPUT TYPE = "hidden" NAME = "Wizard_PlugNPay_Method_Name_&[ l.method ]" VALUE = "&[ l.method_name:entities ]">
						<MvIF EXPR = "{ g.Wizard_PlugNPay_Method_Enabled_&[ l.method ] }">
							<INPUT TYPE = "checkbox" NAME = "Wizard_PlugNPay_Method_Enabled_&[ l.method ]" VALUE = "Yes" CHECKED>
						<MvELSE>
							<INPUT TYPE = "checkbox" NAME = "Wizard_PlugNPay_Method_Enabled_&[ l.method ]" VALUE = "Yes">
						</MvIF>

						<MvEVAL EXPR = "{ l.method_name }">
						</FONT>
					</TD>

					<MvASSIGN NAME = "l.col" VALUE = "{ l.col + 1 }">
					<MvASSIGN NAME = "l.method" VALUE = "{ l.method + 1 }">
				</MvWHILE>

				<MvIF EXPR = "{ l.col LE 2 }">
					</TR>
				</MvIF>
			</TABLE>

			<INPUT TYPE = "hidden" NAME = "Wizard_PlugNPay_Method_Count" VALUE = "&[ g.Wizard_PlugNPay_Method_Count:entities ]">
		</TD></TR>

		<TR><TD COLSPAN = 2>
			&nbsp;
		</TD></TR>

		<TR><TD VALIGN = "bottom" ALIGN = "left">
			<FONT FACE = "Arial, Helvetica" SIZE = "-1">
			<INPUT TYPE = "button" VALUE = "Previous" ONCLICK = "Module_Wizard_Previous();">
			</FONT>
		</TD><TD VALIGN = "bottom" ALIGN = "right">
			<FONT FACE = "Arial, Helvetica" SIZE = "-1">
			<INPUT TYPE = "button" VALUE = "Next" ONCLICK = "Module_Wizard_Finish();">
			</FONT>
		</TD></TR>
		</TABLE>
	<MvELSE>
		<MvASSIGN NAME = "l.card" VALUE = "1">
		<MvWHILE EXPR = "{ l.card LE g.Wizard_PlugNPay_Method_Count }">
			<MvASSIGN NAME = "l.card_code" VALUE = "{ g.Wizard_PlugNPay_Method_Code_&[ l.card ] }">
			<MvASSIGN NAME = "l.card_name" VALUE = "{ g.Wizard_PlugNPay_Method_Name_&[ l.card ] }">
			<MvASSIGN NAME = "l.card_enabled" VALUE = "{ g.Wizard_PlugNPay_Method_Enabled_&[ l.card ] }">

			<INPUT TYPE = "hidden" NAME = "Wizard_PlugNPay_Method_Code_&[ l.card ]" VALUE = "&[ l.card_code:entities ]">
			<INPUT TYPE = "hidden" NAME = "Wizard_PlugNPay_Method_Name_&[ l.card ]" VALUE = "&[ l.card_name:entities ]">
			<INPUT TYPE = "hidden" NAME = "Wizard_PlugNPay_Method_Enabled_&[ l.card ]" VALUE = "&[ l.card_enabled:entities ]">

			<MvASSIGN NAME = "l.card" VALUE = "{ l.card + 1 }">
		</MvWHILE>

		<INPUT TYPE = "hidden" NAME = "Wizard_PlugNPay_Method_Count" VALUE = "&[ g.Wizard_PlugNPay_Method_Count:entities ]">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "1">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Wizard_Summary_Fields" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "merchant,online,cards">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Wizard_Summary_Prompt" PARAMETERS = "field_id" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.prompt" VALUE = "">

	<MvIF EXPR = "{ l.field_id EQ 'merchant' }">
		<MvASSIGN NAME = "l.prompt" VALUE = "Username:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'cards' }">
		<MvASSIGN NAME = "l.prompt" VALUE = "Available Payment Methods:">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.prompt }">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Wizard_Summary_Field" PARAMETERS = "field_id" STANDARDOUTPUTLEVEL = "text, html, compresswhitespace">
	<MvASSIGN NAME = "l.ok" VALUE = 1>

	<MvIF EXPR = "{ l.field_id EQ 'merchant' }">
		<MvEVAL EXPR = "{ g.Wizard_PlugNPay_merchant }">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'cards' }">
		<MvASSIGN NAME = "l.first" VALUE = 1>
		<MvASSIGN NAME = "l.card" VALUE = 1>
		<MvWHILE EXPR = "{ l.card LE g.Wizard_PlugNPay_Method_Count }">
			<MvIF EXPR = "{ g.Wizard_PlugNPay_Method_Enabled_&[ l.card ] }">
				<MvEVAL EXPR = "{ g.Wizard_PlugNPay_Method_Name_&[ l.card ] }"><BR>
			</MvIF>

			<MvASSIGN NAME = "l.card" VALUE = "{ l.card + 1 }">
		</MvWHILE>
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.ok }">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Payment_Methods" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.methods" VALUE = "">

	<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">
	<MvIF EXPR = "{ l.ok }">
		<MvGO NAME = "PlugNPayMethods" ROW = "top">
		<MvWHILE EXPR = "{ NOT PlugNPayMethods.d.EOF }">
			<MvIF EXPR = "{ PlugNPayMethods.d.enabled }">
				<MvIF EXPR = "{ len( l.methods ) }">
					<MvASSIGN NAME = "l.methods" VALUE = "{ l.methods $ ',' }">
				</MvIF>

				<MvASSIGN NAME = "l.methods" VALUE = "{ l.methods $ PlugNPayMethods.d.code $ ':' $ PlugNPayMethods.d.name }">
			</MvIF>

			<MvSKIP NAME = "PlugNPayMethods" ROWS = "1">
		</MvWHILE>

		<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.methods }">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Payment_URL" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.url" VALUE = "">
	<MvFUNCTIONRETURN VALUE = "{ l.url }">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Payment_Description" PARAMETERS = "data" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.desc" VALUE = "">

	<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">
	<MvIF EXPR = "{ l.ok }">
		<MvFIND NAME = "PlugNPayMethods" VALUE = "{ l.data }" EXACT>
		<MvIF EXPR = "{ NOT PlugNPayMethods.d.EOF }">
			<MvASSIGN NAME = "l.desc" VALUE = "{ PlugNPayMethods.d.name }">
		</MvIF>

		<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.desc }">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Payment_Message" PARAMETERS = "data" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Payment_Hide_Additional_Fields" PARAMETERS = "data" STANDARDOUTPUTLEVEL = "text, html, compresswhitespace">
	<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">
	<MvIF EXPR = "{ l.ok }">
		<MvFIND NAME = "PlugNPayMethods" VALUE = "{ l.data }" EXACT>
		<MvIF EXPR = "{ NOT PlugNPayMethods.d.EOF }">
			<INPUT TYPE = "hidden" NAME = "PlugNPay_Method_Type" VALUE = "&[ PlugNPayMethods.d.type:entities ]">
		</MvIF>
		<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
	</MvIF>
	<MvFUNCTIONRETURN VALUE = "{ l.ok }">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Payment_Fields" PARAMETERS = "data" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.fields" VALUE = "">

	<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">
	<MvIF EXPR = "{ l.ok }">
		<MvFIND NAME = "PlugNPayMethods" VALUE = "{ l.data }" EXACT>
		<MvIF EXPR = "{ NOT PlugNPayMethods.d.EOF }">
			<MvIF EXPR = "{ PlugNPayMethods.d.type EQ 'CC' }">
				<MvASSIGN NAME = "l.fields" VALUE = "cc_name,cc_number,cc_exp">
			</MvIF>

			<MvIF EXPR = "{ PlugNPayMethods.d.type EQ 'ECHECK' }">
				<MvASSIGN NAME = "l.fields" VALUE = "check_fname,check_lname,check_bank,check_acct,check_acct_type,check_route">
			</MvIF>
		</MvIF>

		<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.fields }">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Payment_Prompt" PARAMETERS = "data, field_id" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.prompt" VALUE = "">

	<MvIF EXPR = "{ l.field_id EQ 'cc_name' }">
		<MvASSIGN NAME = "l.prompt" VALUE = "Name on Card:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'cc_number' }">
		<MvASSIGN NAME = "l.prompt" VALUE = "Card Number:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'cc_exp' }">
		<MvASSIGN NAME = "l.prompt" VALUE = "Expiration Date:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'check_name' }">
		<MvASSIGN NAME = "l.prompt" VALUE = "First Name on Account:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'check_bank' }">
		<MvASSIGN NAME = "l.prompt" VALUE = "Bank Name:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'check_acct' }">
		<MvASSIGN NAME = "l.prompt" VALUE = "Account Number:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'check_acct_type' }">
		<MvASSIGN NAME = "l.prompt" VALUE = "Account Type:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'check_route' }">
		<MvASSIGN NAME = "l.prompt" VALUE = "9 Digit Routing Number:">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.prompt }">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Payment_Invalid" PARAMETERS = "data, field_id" STANDARDOUTPUTLEVEL = "">

	<MvASSIGN NAME = "l.invalid" VALUE = 0>

	<MvIF EXPR = "{ l.field_id EQ 'cc_name' AND g.PlugNPay_CardName_Invalid }">
		<MvASSIGN NAME = "l.invalid" VALUE = 1>
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'cc_number' AND g.PlugNPay_Card_Num_Invalid }">
		<MvASSIGN NAME = "l.invalid" VALUE = 1>
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'cc_exp' AND g.PlugNPay_CardExp_Invalid }">
		<MvASSIGN NAME = "l.invalid" VALUE = 1>
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'check_name' AND g.PlugNPay_AcctName_Invalid }">
		<MvASSIGN NAME = "l.invalid" VALUE = 1>
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'check_bank' AND g.PlugNPay_Bank_Name_Invalid }">
		<MvASSIGN NAME = "l.invalid" VALUE = 1>
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'check_acct' AND g.PlugNPay_Bank_Acct_Num_Invalid }">
		<MvASSIGN NAME = "l.invalid" VALUE = 1>
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'check_route' AND g.PlugNPay_Bank_ABA_Code_Invalid }">
		<MvASSIGN NAME = "l.invalid" VALUE = 1>
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.invalid }">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Payment_Field" PARAMETERS = "data, field_id" STANDARDOUTPUTLEVEL = "text, html, compresswhitespace">

	<MvIF EXPR = "{ l.field_id EQ 'cc_name' }">
		<INPUT TYPE = "text" NAME = "PlugNPay_CardName" SIZE = 16 VALUE = "&[ g.PlugNPay_CardName:entities ]">&nbsp;
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'cc_number' }">
		<INPUT TYPE = "text" NAME = "PlugNPay_Card_Num" SIZE = 16 VALUE = "&[ g.PlugNPay_Card_Num:entities ]">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'cc_exp' }">
		<SELECT NAME = "PlugNPay_CardExp_Month">
		<OPTION VALUE = "">&lt;Month&gt;</OPTION>

		<MvASSIGN NAME = "l.month" VALUE = 1>
		<MvWHILE EXPR = "{ l.month LE 12 }">
			<MvIF EXPR = "{ g.PlugNPay_CardExp_Month EQ l.month }">
				<OPTION VALUE = "&[ l.month ]" SELECTED><MvEVAL EXPR = "{ l.month }"></OPTION>
			<MvELSE>
				<OPTION VALUE = "&[ l.month ]"><MvEVAL EXPR = "{ l.month }"></OPTION>
			</MvIF>

			<MvASSIGN NAME = "l.month" VALUE = "{ l.month + 1 }">
		</MvWHILE>

		</SELECT>

		/
		<MvASSIGN NAME = "l.year" VALUE = "{ s.dyn_tm_year }">
		<MvASSIGN NAME = "l.count" VALUE = 1>

		<SELECT NAME = "PlugNPay_CardExp_Year">
		<OPTION VALUE = "">&lt;Year&gt;</OPTION>

		<MvWHILE EXPR = "{ l.count LE 10 }">
			<MvIF EXPR = "{ g.PlugNPay_CardExp_Year EQ l.year }">
				<OPTION VALUE = "&[ l.year ]" SELECTED><MvEVAL EXPR = "{ l.year }"></OPTION>
			<MvELSE>
				<OPTION VALUE = "&[ l.year ]"><MvEVAL EXPR = "{ l.year }"></OPTION>
			</MvIF>

			<MvASSIGN NAME = "l.year" VALUE = "{ l.year + 1 }">
			<MvASSIGN NAME = "l.count" VALUE = "{ l.count + 1 }">
		</MvWHILE>

		</SELECT>
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'check_name' }">
		<INPUT TYPE = "text" NAME = "PlugNPay_AcctName" SIZE = 16 VALUE = "&[ g.PlugNPay_AcctName:entities ]">&nbsp;
	</MvIF>

		<MvIF EXPR = "{ l.field_id EQ 'check_bank' }">
		<INPUT TYPE = "text" NAME = "PlugNPay_Bank_Name" SIZE = 20 VALUE = "&[ g.PlugNPay_Bank_Name:entities ]">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'check_acct' }">
		<INPUT TYPE = "text" NAME = "PlugNPay_Bank_Acct_Num" SIZE = 17 VALUE = "&[ g.PlugNPay_Bank_Acct_Num:entities ]">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'check_acct_type' }">
		<MvIF EXPR = "{ g.PlugNPay_Bank_Acct_Type EQ 'SAVING' }">
			<INPUT TYPE = "radio" NAME = "PlugNPay_Bank_Acct_Type" VALUE = "CHECKING">Checking&nbsp;&nbsp;
			<INPUT TYPE = "radio" NAME = "PlugNPay_Bank_Acct_Type" VALUE = "SAVING" CHECKED >Savings
		<MvELSE>
			<INPUT TYPE = "radio" NAME = "PlugNPay_Bank_Acct_Type" VALUE = "CHECKING" CHECKED >Checking&nbsp;&nbsp;
			<INPUT TYPE = "radio" NAME = "PlugNPay_Bank_Acct_Type" VALUE = "SAVING" >Savings
		</MvIF>
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'check_route' }">
		<INPUT TYPE = "text" NAME = "PlugNPay_Bank_ABA_Code" SIZE = 9 VALUE = "&[ g.PlugNPay_Bank_ABA_Code:entities ]">
	</MvIF>
	<MvFUNCTIONRETURN VALUE = "{ l.ok }">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Payment_Validate" PARAMETERS = "pay_data" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.valid" VALUE = 1>

	<MvIF EXPR = "{ g.PlugNPay_Method_Type EQ 'CC' }">

		<MvASSIGN NAME = "g.PlugNPay_CardName" VALUE = "{ ltrim( rtrim( g.PlugNPay_CardName ) ) }">
		<MvIF EXPR = "{ len( g.PlugNPay_CardName ) EQ 0 }">
			<MvASSIGN NAME = "g.PlugNPay_CardName_Invalid" VALUE = 1>
			<MvASSIGN NAME = "l.valid" VALUE = 0>
		</MvIF>


		<MvASSIGN NAME = "g.PlugNPay_Card_Num" VALUE = "{ glosub( glosub( ltrim( rtrim( g.PlugNPay_Card_Num ) ), '-', '' ), ' ', '' ) }">
		<MvIF EXPR = "{ len( g.PlugNPay_Card_Num ) EQ 0 }">
			<MvASSIGN NAME = "g.PlugNPay_Card_Num_Invalid" VALUE = 1>
			<MvASSIGN NAME = "l.valid" VALUE = 0>
		</MvIF>

		<MvIF EXPR = "{ ( g.PlugNPay_CardExp_Year LT s.dyn_tm_year ) OR
						( ( g.PlugNPay_CardExp_Year EQ s.dyn_tm_year ) AND
						  ( g.PlugNPay_CardExp_Month LT s.dyn_tm_mon ) ) }">
			<MvASSIGN NAME = "l.valid" VALUE = 0>
			<MvASSIGN NAME = "g.PlugNPay_CardExp_Invalid" VALUE = 1>
		</MvIF>

	<MvELSE>

		<MvASSIGN NAME = "g.PlugNPay_AcctName" VALUE = "{ ltrim( rtrim( g.PlugNPay_AcctName ) ) }">
		<MvIF EXPR = "{ len( g.PlugNPay_AcctName ) EQ 0 }">
			<MvASSIGN NAME = "g.PlugNPay_AcctName_Invalid" VALUE = 1>
			<MvASSIGN NAME = "l.valid" VALUE = 0>
		</MvIF>

		<MvASSIGN NAME = "g.PlugNPay_Bank_Name" VALUE = "{ ltrim( rtrim( g.PlugNPay_Bank_Name ) ) }">
		<MvIF EXPR = "{ len( g.PlugNPay_Bank_Name ) EQ 0 }">
			<MvASSIGN NAME = "g.PlugNPay_Bank_Name_Invalid" VALUE = 1>
			<MvASSIGN NAME = "l.valid" VALUE = 0>
		</MvIF>
		
		<MvASSIGN NAME = "g.PlugNPay_Bank_Acct_Num" VALUE = "{ glosub( glosub( ltrim( rtrim( g.PlugNPay_Bank_Acct_Num ) ), '-', '' ), ' ', '' ) }">
		<MvIF EXPR = "{ len( g.PlugNPay_Bank_Acct_Num ) EQ 0 }">
			<MvASSIGN NAME = "g.PlugNPay_Bank_Acct_Num_Invalid" VALUE = 1>
			<MvASSIGN NAME = "l.valid" VALUE = 0>
		</MvIF>

		<MvASSIGN NAME = "g.PlugNPay_Bank_ABA_Code" VALUE = "{ glosub( glosub( ltrim( rtrim( g.PlugNPay_Bank_ABA_Code ) ), '-', '' ), ' ', '' ) }">
		<MvIF EXPR = "{ len( g.PlugNPay_Bank_ABA_Code ) NE 9 }">
			<MvASSIGN NAME = "g.PlugNPay_Bank_ABA_Code_Invalid" VALUE = 1>
			<MvASSIGN NAME = "l.valid" VALUE = 0>
		</MvIF>

	</MvIF>
	<MvFUNCTIONRETURN VALUE = "{ l.valid }">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Report_Description" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "PlugNPay.Com">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Report_Fields" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">
	<MvIF EXPR = "{ l.ok }">
		<MvFIND NAME = "PlugNPayOrders" VALUE = "{ Orders.d.id }" EXACT>
		<MvIF EXPR = "{ NOT PlugNPayOrders.d.EOF }">
			<MvASSIGN NAME = "g.PlugNPayOrder_OrderNumber" VALUE = "{ PlugNPayOrders.d.order_id }">
			<MvASSIGN NAME = "g.PlugNPayOrder_Error" VALUE = "{ PlugNPayOrders.d.r_r_text }">
			<MvASSIGN NAME = "g.PlugNPayOrder_ApprovalCode" VALUE = "{ PlugNPayOrders.d.auth_code }">
			<MvASSIGN NAME = "g.PlugNPayOrder_AVS_Code"	VALUE = "{ PlugNPayOrders.d.avs_code }">
			<MvASSIGN NAME = "g.PlugNPayOrder_ReferenceNumber" VALUE = "{ PlugNPayOrders.d.trans_id }">
			<MvASSIGN NAME = "g.PlugNPayOrder_CC_Number" VALUE = "{ PlugNPayOrders.d.card_num }">
			<MvASSIGN NAME = "g.PlugNPayOrder_CC_Name" VALUE = "{ PlugNPayOrders.d.cc_name }">
			<MvASSIGN NAME = "g.PlugNPayOrder_CC_Exp_Date" VALUE = "{ PlugNPayOrders.d.exp_date }">
			<MvASSIGN NAME = "g.PlugNPayOrder_Bank_Name" VALUE = "{ PlugNPayOrders.d.bank_name }">
			<MvASSIGN NAME = "g.PlugNPayOrder_Acct_Num" VALUE = "{ PlugNPayOrders.d.acct_num }">
			<MvASSIGN NAME = "g.PlugNPayOrder_Acct_Type" VALUE = "{ PlugNPayOrders.d.acct_type }">
			<MvASSIGN NAME = "g.PlugNPayOrder_ABA_Code" VALUE = "{ PlugNPayOrders.d.aba_code }">
			<MvASSIGN NAME = "g.PlugNPayOrder_Time" VALUE = "{ PlugNPayOrders.d.time }">

			<MvIF EXPR = "{ PlugNPayOrders.d.method EQ 'CC' }">
				<MvASSIGN NAME = "l.fields" VALUE = "cc_name,card_num,exp_date,trans_id,auth_code,avs_code,r_r_text,time">
			<MvELSE>
				<MvASSIGN NAME = "l.fields" VALUE = "bcard_name,bank_name,acct_num,acct_type,aba_code,trans_id,auth_code,time">
			</MvIF>
			<MvIF EXPR = "{ len( g.PlugNPayOrder_Error ) }">
				<MvASSIGN NAME = "l.fields" VALUE = "{ l.fields $ ',ch_error' }">
			</MvIF>
		</MvIF>

		<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.fields }">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Report_Label" PARAMETERS = "field_id" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.label" VALUE = "">

	<MvIF EXPR = "{ l.field_id EQ 'bank_name' }">
		<MvASSIGN NAME = "l.label" VALUE = "Bank Name:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'acct_num' }">
		<MvASSIGN NAME = "l.label" VALUE = "Account Number:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'acct_type' }">
		<MvASSIGN NAME = "l.label" VALUE = "Account Type:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'aba_code' }">
		<MvASSIGN NAME = "l.label" VALUE = "Bank Routing Code">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'cc_name' }">
		<MvASSIGN NAME = "l.label" VALUE = "Name On Card:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'bcard_name' }">
		<MvASSIGN NAME = "l.label" VALUE = "Name On Account:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'card_num' }">
		<MvASSIGN NAME = "l.label" VALUE = "Card Number:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'exp_date' }">
		<MvASSIGN NAME = "l.label" VALUE = "Expiration Date:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'time' }">
		<MvASSIGN NAME = "l.label" VALUE = "Time:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'trans_id' }">
		<MvASSIGN NAME = "l.label" VALUE = "Transaction ID:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'auth_code' }">
		<MvASSIGN NAME = "l.label" VALUE = "Authorization Code:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'avs_code' }">
		<MvASSIGN NAME = "l.label" VALUE = "AVS Code:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'order_id' }">
		<MvASSIGN NAME = "l.label" VALUE = "Order #:">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'r_r_text' }">
		<MvASSIGN NAME = "l.label" VALUE = "PlugNPay Response:">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.label }">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Report_Value" PARAMETERS = "field_id" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.value" VALUE = "">
	<MvIF EXPR = "{ l.field_id EQ 'bank_name' }">
		<MvASSIGN NAME = "l.value" VALUE = "{ g.PlugNPayOrder_Bank_Name }">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'acct_num' }">
		<MvASSIGN NAME = "l.value" VALUE = "{ g.PlugNPayOrder_Acct_Num }">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'acct_type' }">
		<MvASSIGN NAME = "l.value" VALUE = "{ g.PlugNPayOrder_Acct_Type }">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'aba_code' }">
		<MvASSIGN NAME = "l.value" VALUE = "{ g.PlugNPayOrder_ABA_Code }">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'bcard_name' OR l.field_id EQ 'cc_name' }">
		<MvASSIGN NAME = "l.value" VALUE = "{ g.PlugNPayOrder_CC_Name }">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'card_num' }">
		<MvASSIGN NAME = "l.value" VALUE = "{ g.PlugNPayOrder_CC_Number }">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'exp_date' }">
		<MvASSIGN NAME = "l.value" VALUE = "{ g.PlugNPayOrder_CC_Exp_Date }">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'time' }">
		<MvASSIGN NAME = "l.value" VALUE = "{ padl( time_t_month( g.PlugNPayOrder_Time, timezone() ), 2, '0') $ '/' $ padl( time_t_dayofmonth( g.PlugNPayOrder_Time, timezone() ), 2, '0')
									$ '/' $ time_t_year( g.PlugNPayOrder_Time, timezone() ) $ ' - ' $ padl( time_t_hour( g.PlugNPayOrder_Time, timezone() ), 2, '0' )
									$ ':' $ padl( time_t_min( g.PlugNPayOrder_Time, timezone() ), 2, '0' ) $ ':' $ padl( time_t_sec( g.PlugNPayOrder_Time, timezone() ), 2, '0' )
									$ ' ' $ stm_zone }">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'trans_id' }">
		<MvASSIGN NAME = "l.value" VALUE = "{ g.PlugNPayOrder_ReferenceNumber }">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'auth_code' }">
		<MvASSIGN NAME = "l.value" VALUE = "{ g.PlugNPayOrder_ApprovalCode }">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'avs_code' }">
		<MvASSIGN NAME = "l.value" VALUE = "{ g.PlugNPayOrder_AVS_Code }">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'order_id' }">
		<MvASSIGN NAME = "l.value" VALUE = "{ g.PlugNPayOrder_OrderNumber }">
	</MvIF>

	<MvIF EXPR = "{ l.field_id EQ 'r_r_text' }">
		<MvASSIGN NAME = "l.value" VALUE = "{ g.PlugNPayOrder_Error }">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.value }">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Authorize" PARAMETERS = "data, total" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.processed" VALUE = 0>

	<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">
	<MvIF EXPR = "{ l.ok }">

		<MvFIND NAME = "PlugNPayMethods" VALUE = "{ l.data }" EXACT>
		<MvIF EXPR = "{ PlugNPayMethods.d.type EQ 'ECHECK' }">
			<MvASSIGN NAME = "l.x_paymethod" VALUE = "check">
		<MvELSE>
			<MvASSIGN NAME = "l.x_paymethod" VALUE = "credit">
		</MvIF>

		<MvASSIGN NAME = "l.formatted_total"		VALUE = "{ l.total ROUND 2 }">
		<MvASSIGN NAME = "l.x_Version"			VALUE = "3.0">
		<MvASSIGN NAME = "l.x_merchant"			VALUE = "{ PlugNPay.d.merchant }">
		<MvASSIGN NAME = "l.x_Invoice_Num"			VALUE = "{ BasketList.d.order_id }">
		<MvASSIGN NAME = "l.x_Amount"				VALUE = "{ l.formatted_total }">
		<MvASSIGN NAME = "l.x_Description"			VALUE = "Miva Merchant Order">
		<MvASSIGN NAME = "l.x_Cust_ID"				VALUE = "Online Customer">
		<MvASSIGN NAME = "l.x_Method"				VALUE = "{ PlugNPayMethods.d.type }">
		<MvASSIGN NAME = "l.x_Phone"				VALUE = "{ BasketList.d.bill_phone }">
		<MvASSIGN NAME = "l.x_Fax"					VALUE = "{ BasketList.d.bill_fax }">
		<MvASSIGN NAME = "l.x_Email"				VALUE = "{ BasketList.d.bill_email }">
		<MvASSIGN NAME = "l.x_Company"				VALUE = "{ BasketList.d.bill_comp }">
		<MvASSIGN NAME = "l.x_Address"				VALUE = "{ BasketList.d.bill_addr }">
		<MvASSIGN NAME = "l.x_City"					VALUE = "{ BasketList.d.bill_city }">
		<MvASSIGN NAME = "l.x_State"				VALUE = "{ BasketList.d.bill_state }">
		<MvASSIGN NAME = "l.x_Zip"					VALUE = "{ BasketList.d.bill_zip }">
		<MvASSIGN NAME = "l.x_Country"				VALUE = "{ BasketList.d.bill_cntry }">
		<MvASSIGN NAME = "l.x_Card_Name"			VALUE = "{ g.PlugNPay_CardName }">
		<MvASSIGN NAME = "l.x_Ship_To_First_Name"	VALUE = "{ BasketList.d.ship_fname }">
		<MvASSIGN NAME = "l.x_Ship_To_Last_Name"	VALUE = "{ BasketList.d.ship_lname }">
		<MvASSIGN NAME = "l.x_Ship_To_Company"		VALUE = "{ BasketList.d.ship_comp }">
		<MvASSIGN NAME = "l.x_Ship_To_Address"		VALUE = "{ BasketList.d.ship_addr }">
		<MvASSIGN NAME = "l.x_Ship_To_City"			VALUE = "{ BasketList.d.ship_city }">
		<MvASSIGN NAME = "l.x_Ship_To_State"		VALUE = "{ BasketList.d.ship_state }">
		<MvASSIGN NAME = "l.x_Ship_To_Zip"			VALUE = "{ BasketList.d.ship_zip }">
		<MvASSIGN NAME = "l.x_Ship_To_Country"		VALUE = "{ BasketList.d.ship_cntry }">

		<MvASSIGN NAME = "l.fields"			VALUE = "x_paymethod,x_Version,x_merchant,x_Invoice_Num,x_Amount,x_Description,x_Cust_ID,x_Method,x_Phone,x_Fax,x_Email,
													 x_Company,x_Address,x_City,x_State,x_Zip,x_Country,x_Card_Name,x_AVS_Filter,
													 x_Ship_To_First_Name,x_Ship_To_Last_Name,x_Ship_To_Company,x_Ship_To_Address,x_Ship_To_City,
													 x_Ship_To_State,x_Ship_To_Zip,x_Ship_To_Country,x_Test_Request">

		<MvIF EXPR = "{ l.x_Method EQ 'CC' }">
			<MvASSIGN NAME = "l.x_Card_Num"	VALUE = "{ g.PlugNPay_Card_Num }">
			<MvASSIGN NAME = "l.x_Exp_Date" VALUE = "{ g.PlugNPay_CardExp_Month $ '/' $ g.PlugNPay_CardExp_Year }">
			<MvASSIGN NAME = "l.fields"		VALUE = "{ l.fields $ ',x_Card_Num,x_Exp_Date' }">
		<MvELSE>
			<MvASSIGN NAME = "l.x_Bank_Name"		VALUE = "{ g.PlugNPay_Bank_Name }">
			<MvASSIGN NAME = "l.x_Bank_Acct_Num"	VALUE = "{ g.PlugNPay_Bank_Acct_Num }">
			<MvASSIGN NAME = "l.x_Bank_Acct_Type"	VALUE = "{ g.PlugNPay_Bank_Acct_Type }">
			<MvASSIGN NAME = "l.x_Bank_ABA_Code"	VALUE = "{ g.PlugNPay_Bank_ABA_Code }">
			<MvASSIGN NAME = "l.fields"				VALUE = "{ l.fields $ ',x_Bank_Name,x_Bank_Acct_Num,x_Bank_Acct_Type,x_Bank_ABA_Code' }">
		</MvIF>

		<MIVA MvCOMMERCE_Error = "nonfatal, nodisplay">
		<MvCOMMERCE METAMETHOD = "PlugNPay"
					ACTION = "{ PlugNPay.d.url }"
					FIELDS = "{ l.fields }">

			<MvIF EXPR = "{ s.FinalStatus EQ 'success' }">

				<MvASSIGN NAME = "l.processed" VALUE = 1>
				<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPayOrders_Insert( BasketList.d.order_id,
								decodeattribute(s.auth_msg),
								s.auth_code,
								s.avs_code,
								s.order_id,
								l.card_amount,
								l.x_Card_Num,
								l.x_Card_Name,
								l.x_Exp_Date,
								l.x_Method,
								l.x_Bank_Name,
								l.x_Bank_Acct_Num,
								l.x_Bank_Acct_Type,
								l.x_Bank_ABA_Code
								 ) }">
				<MvASSIGN NAME = "l.processed" VALUE = 1>
			<MvELSE>
				<MvIF EXPR = "{ len( s.MErrMsg ) }">
					<MvASSIGN NAME = "g.Authorization_Failure_Message"	VALUE = "{ decodeattribute(s.MErrMsg) }">
				<MvELSE>
					<MvASSIGN NAME = "g.Authorization_Failure_Message" VALUE = "{ decodeattribute(s.MErrMsg) }">
				</MvIF>
			</MvIF>

		</MvCOMMERCE>
		<MIVA MvCOMMERCE_Error = "fatal, display">

		<MvIF EXPR = "{ MvCOMMERCE_Error }">
			<MvASSIGN NAME = "g.Authorization_Failure_Message" VALUE = "{ MvCOMMERCE_Error }">
		</MvIF>
		<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.processed }">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Process" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">
	<MvIF EXPR = "{ l.ok }">

		<MvFIND NAME = "PlugNPayOrders" VALUE = "{ Orders.d.id }" EXACT>
		<MvIF EXPR = "{ NOT PlugNPayOrders.d.EOF }">
			<MvIF EXPR = "{ PlugNPay.d.authcapt }">
				<MvASSIGN NAME = "l.processed" VALUE = 1>
			<MvELSE>
				<MvASSIGN NAME = "l.processed" VALUE = 0>
				<MvASSIGN NAME = "l.x_Version" VALUE = "1.0">
				<MvASSIGN NAME = "l.x_paymethod" VALUE = "PRIOR_AUTH_CAPTURE">
				<MvASSIGN NAME = "l.x_merchant" VALUE = "{ PlugNPay.d.merchant }">
				<MvASSIGN NAME = "l.x_Card_Num" VALUE = "{ PlugNPayOrders.d.card_num }">
				<MvASSIGN NAME = "l.x_Auth_Code" VALUE = "{ PlugNPayOrders.d.auth_code }">
				<MvASSIGN NAME = "l.x_Invoice_Num" VALUE = "{ PlugNPayOrders.d.order_id }">
				<MvASSIGN NAME = "l.x_Amount" VALUE = "{ PlugNPayOrders.d.amount }">
				<MvASSIGN NAME = "l.order_id" VALUE = "{ int( PlugNPayOrders.d.trans_id ) }">
				<MvASSIGN NAME = "l.fields" VALUE = "x_merchant,x_Version,x_paymethod,x_Card_Num,x_Auth_Code,x_Invoice_Num,x_Amount,order_id">

				<MIVA MvCOMMERCE_Error = "nonfatal, nodisplay">
				<MvCOMMERCE METAMETHOD = "PlugNPay"
							ACTION = "{ PlugNPay.d.url }"
							FIELDS = "{ l.fields }">
   					<MvIF EXPR = "{ s.FinalStatus EQ 'success' }">
						<MvASSIGN NAME = "l.processed" VALUE = 1>
						<MvASSIGN NAME = "PlugNPayOrders.d.auth_code"	VALUE = "{ s.auth_code }">
						<MvASSIGN NAME = "PlugNPayOrders.d.r_r_text" VALUE = "{ decodeattribute(s.auth_msg) }">
					<MvELSE>
						<MvIF EXPR = "{ len( s.MErrMsg ) }">
							<MvASSIGN NAME = "PlugNPayOrders.d.r_r_text" VALUE = "{ decodeattribute(s.MErrMsg) }">
							<MvASSIGN NAME = "g.Authorization_Failure_Message"	VALUE = "{ decodeattribute(s.MErrMsg) }">
						<MvELSE>
							<MvASSIGN NAME = "PlugNPayOrders.d.r_r_text" VALUE = "{ decodeattribute(s.MErrMsg) }">
							<MvASSIGN NAME = "g.Authorization_Failure_Message" VALUE = "{ decodeattribute(s.MErrMsg) }">
						</MvIF>
					</MvIF>
				</MvCOMMERCE>

				<MIVA MvCOMMERCE_Error = "fatal, display">

				<MvIF EXPR = "{ MvCOMMERCE_Error }">
						<MvASSIGN NAME = "g.Authorization_Failure_Message" VALUE = "{ MvCOMMERCE_Error }">
						<MvASSIGN NAME = "PlugNPayOrders.d.r_r_text"   VALUE = "{ MvCOMMERCE_Error }">
				</MvIF>
				<MvUPDATE NAME = "PlugNPayOrders">
			</MvIF>
		</MvIF>

		<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.processed }">
</MvFUNCTION>

<MvFUNCTION NAME = "PlugNPay_Open_Store" STANDARDOUTPUTLEVEL = "" ERROROUTPUTLEVEL = "syntax, expression">
	<MvASSIGN NAME = "l.ok" VALUE = "1">

	<MvASSIGN NAME = "l.directory" VALUE = "{ g.MerchantPath $ padl( Stores.d.id, 8, '0' ) $ '/plugnpay/' }">

	<MvOPEN NAME = "PlugNPay" DATABASE = "{ l.directory $ 'plugnpay.dbf' }">
	<MvIF EXPR = "{ MvOPEN_Error }">
		<MvDO FILE = "{ g.Module_Library_Utilities }" NAME = "l.ok" VALUE = "{ Error( 'MER-ATH-00007', MvOPEN_Error ) }">
	</MvIF> 

	<MvIF EXPR = "{ l.ok }">
		<MvOPEN NAME = "PlugNPayMethods" DATABASE = "{ l.directory $ 'authmeth.dbf' }" INDEXES = "{ l.directory $ 'authmeth.mvx' }">
		<MvIF EXPR = "{ MvOPEN_Error }">
			<MvDO FILE = "{ g.Module_Library_Utilities }" NAME = "l.ok" VALUE = "{ Error( 'MER-ATH-00008', MvOPEN_Error ) }">
		<MvELSE>
			<MvFILTER NAME = "PlugNPayMethods" FILTER = "{ NOT PlugNPayMethods.d.deleted }">
		</MvIF>
	</MvIF>

	<MvIF EXPR = "{ l.ok }">
		<MvOPEN NAME = "PlugNPayOrders" DATABASE = "{ l.directory $ 'aunorder.dbf' }" INDEXES = "{ l.directory $ 'aunorder.mvx' }">
		<MvIF EXPR = "{ MvOPEN_Error }">
			<MvDO FILE = "{ g.Module_Library_Utilities }" NAME = "l.ok" VALUE = "{ Error( 'MER-ATH-00009', MvOPEN_Error ) }">
		<MvELSE>
			<MvFILTER NAME = "PlugNPayOrders" FILTER = "{ NOT PlugNPayOrders.d.deleted }">
		</MvIF>
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.ok }">
</MvFUNCTION>

<MvFUNCTION NAME = "PlugNPay_Close_Store">
	<MvCLOSE NAME = "PlugNPay">
	<MvCLOSE NAME = "PlugNPayMethods">
	<MvCLOSE NAME = "PlugNPayOrders">

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "PlugNPayMethods_Insert" PARAMETERS = "code, name, type, enabled">
	<MvASSIGN NAME = "PlugNPayMethods.d.code" VALUE = "{ l.code }">
	<MvASSIGN NAME = "PlugNPayMethods.d.name" VALUE = "{ l.name }">
	<MvASSIGN NAME = "PlugNPayMethods.d.type" VALUE = "{ l.type }">
	<MvASSIGN NAME = "PlugNPayMethods.d.enabled" VALUE = "{ l.enabled }">

	<MvADD NAME = "PlugNPayMethods">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "PlugNPayOrders_Insert" PARAMETERS = "order_id, auth_msg, auth_code, avs_code, trans_id, amount, card_num, cc_name,
															 exp_date, method, bank_name, bank_acct_num, bank_acct_type, bank_aba_code">

	<MvASSIGN NAME = "PlugNPayOrders.d.order_id"	VALUE = "{ l.order_id }">
	<MvASSIGN NAME = "PlugNPayOrders.d.r_r_text"	VALUE = "{ decodeattribute(l.auth_msg) }">
	<MvASSIGN NAME = "PlugNPayOrders.d.auth_code"	VALUE = "{ l.auth_code }">
	<MvASSIGN NAME = "PlugNPayOrders.d.avs_code"	VALUE = "{ l.avs_code }">
	<MvASSIGN NAME = "PlugNPayOrders.d.trans_id"	VALUE = "{ l.trans_id }">
	<MvASSIGN NAME = "PlugNPayOrders.d.amount"	VALUE = "{ l.amount }">
	<MvASSIGN NAME = "PlugNPayOrders.d.card_num"	VALUE = "{ substring( l.card_num, 0, 4 ) $ '...' $ substring( l.card_num, len(l.card_num)-4, 4 ) }">
	<MvASSIGN NAME = "PlugNPayOrders.d.cc_name"	VALUE = "{ l.cc_name }">
	<MvASSIGN NAME = "PlugNPayOrders.d.exp_date"	VALUE = "{ l.exp_date }">
	<MvASSIGN NAME = "PlugNPayOrders.d.method"	VALUE = "{ l.method }">
	<MvASSIGN NAME = "PlugNPayOrders.d.bank_name"	VALUE = "{ l.bank_name }">
	<MvASSIGN NAME = "PlugNPayOrders.d.acct_num"	VALUE = "{ l.bank_acct_num }">
	<MvASSIGN NAME = "PlugNPayOrders.d.acct_type"	VALUE = "{ l.bank_acct_type }">
	<MvASSIGN NAME = "PlugNPayOrders.d.aba_code"	VALUE = "{ l.bank_aba_code }">
	<MvASSIGN NAME = "PlugNPayOrders.d.time"		VALUE = "{ dyn_time_t }">

	<MvADD NAME = "PlugNPayOrders">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Category_Validate" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Category_Update" PARAMETERS = "category_id" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Category_Delete" PARAMETERS = "category_id" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Category_Tabs" PARAMETERS = "category_id" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Category_Content" PARAMETERS = "tab, load_fields, category_id" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Product_Tabs" PARAMETERS = "product_id" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Product_Content" PARAMETERS = "tab, load_fields, product_id" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Product_Validate" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Product_Update" PARAMETERS = "product_id" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Product_Delete" PARAMETERS = "product_id" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Store_Validate" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "g.Store_PlugNPay_merchant" VALUE = "{ ltrim( rtrim( g.Store_PlugNPay_merchant ) ) }">
	<MvASSIGN NAME = "g.Store_PlugNPay_URL" VALUE = "{ ltrim( rtrim( g.Store_PlugNPay_URL ) ) }">

	<MvIF EXPR = "{ len( g.Store_PlugNPay_merchant ) EQ 0 }">
		<MvDO FILE = "{ g.Module_Admin }" NAME = "l.valid" VALUE = "{ FieldError( 'PLUGNPAY', 'Store_PlugNPay_merchant', 'Please specify a username' ) }">
		<MvFUNCTIONRETURN VALUE = 0>
	</MvIF>

	<MvIF EXPR = "{ len( g.Store_PlugNPay_URL ) EQ 0 }">
		<MvDO FILE = "{ g.Module_Admin }" NAME = "l.valid" VALUE = "{ FieldError( 'PLUGNPAY', 'Store_PlugNPay_URL', 'Please specify a url' ) }">
		<MvFUNCTIONRETURN VALUE = 0>
	</MvIF>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Store_Update" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">
	<MvIF EXPR = "{ l.ok }">
		<MvASSIGN NAME = "PlugNPay.d.merchant" VALUE = "{ g.Store_PlugNPay_merchant }">
		<MvASSIGN NAME = "PlugNPay.d.password" VALUE = "{ g.Store_PlugNPay_Password }">
		<MvASSIGN NAME = "PlugNPay.d.url" VALUE = "{ g.Store_PlugNPay_URL }">
		<MvASSIGN NAME = "PlugNPay.d.authcapt" VALUE = "{ g.Store_PlugNPay_AuthCapt }">
		<MvASSIGN NAME = "PlugNPay.d.full_cc" VALUE = "{ g.Store_PlugNPay_FullCC }">
		<MvASSIGN NAME = "PlugNPay.d.test_mode" VALUE = "{ g.Store_PlugNPay_Test_Mode }">
		<MvUPDATE NAME = "PlugNPay">

		<MvASSIGN NAME = "l.method" VALUE = 1>
		<MvWHILE EXPR = "{ l.method LE g.Store_PlugNPay_Method_Count }">
			<MvFIND NAME = "PlugNPayMethods" VALUE = "{ g.Store_PlugNPay_Method_Code_&[ l.method ] }" EXACT>
			<MvIF EXPR = "{ NOT PlugNPayMethods.d.EOF }">
				<MvASSIGN NAME = "PlugNPayMethods.d.enabled" VALUE = "{ g.Store_PlugNPay_Method_Enabled_&[ l.method ] }">
				<MvUPDATE NAME = "PlugNPayMethods">
			</MvIF>

			<MvASSIGN NAME = "l.method" VALUE = "{ l.method + 1 }">
		</MvWHILE>

		<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.ok }">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Store_Tabs" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "PLUGNPAY:Plug & Pay Technologies Inc. v1.0">
</MvFUNCTION>

<MvFUNCTION NAME = "Module_Store_Content" PARAMETERS = "tab, load_fields" STANDARDOUTPUTLEVEL = "text, html, compresswhitespace">
	<MvASSIGN NAME = "l.ok" VALUE = 1>

	<MvIF EXPR = "{ l.load_fields }">
		<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">
		<MvIF EXPR = "{ l.ok }">
			<MvASSIGN NAME = "g.Store_PlugNPay_merchant"	VALUE = "{ PlugNPay.d.merchant }">
			<MvASSIGN NAME = "g.Store_PlugNPay_URL"			VALUE = "{ PlugNPay.d.url }">

			<MvGO NAME = "PlugNPayMethods" ROW = "top">
			<MvWHILE EXPR = "{ NOT PlugNPayMethods.d.EOF }">
				<MvASSIGN NAME = "l.method" VALUE = "{ l.method + 1 }">

				<MvASSIGN NAME = "g.Store_PlugNPay_Method_Code_&[ l.method ]" VALUE = "{ PlugNPayMethods.d.code }">
				<MvASSIGN NAME = "g.Store_PlugNPay_Method_Name_&[ l.method ]" VALUE = "{ PlugNPayMethods.d.name }">
				<MvASSIGN NAME = "g.Store_PlugNPay_Method_Enabled_&[ l.method ]" VALUE = "{ PlugNPayMethods.d.enabled }">

				<MvSKIP NAME = "PlugNPayMethods" ROWS = 1>
			</MvWHILE>

			<MvASSIGN NAME = "g.Store_PlugNPay_Method_Count" VALUE = "{ l.method }">

			<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
		</MvIF>
	</MvIF>

	<MvIF EXPR = "{ l.ok }">
		<MvIF EXPR = "{ g.Tab EQ 'PLUGNPAY' }">
			<TABLE BORDER = 0 CELLPADDING = 2 CELLSPACING = 0>
			<TR><TD NOWRAP>
				<FONT SIZE = "-1" FACE = "Arial, Helvetica">
				<B>Username:</B>
				</FONT>
			</TD><TD WIDTH = "100%">
				<FONT SIZE = "-1" FACE = "Arial, Helvetica">
				<INPUT TYPE = "text" NAME = "Store_PlugNPay_merchant" SIZE = 40 VALUE = "&[ g.Store_PlugNPay_merchant:entities ]">
				</FONT>
			</TD></TR>

			<TR><TD NOWRAP>
				<FONT SIZE = "-1" FACE = "Arial, Helvetica">
				<B>PlugNPay.Com URL:</B>
				</FONT>
			</TD><TD WIDTH = "100%">
				<FONT SIZE = "-1" FACE = "Arial, Helvetica">
				<INPUT TYPE = "text" NAME = "Store_PlugNPay_URL" SIZE = 40 VALUE = "&[ g.Store_PlugNPay_URL:entities ]">
				</FONT>
			</TD></TR>

			<TR><TD VALIGN = "top" NOWRAP>
				<FONT SIZE = "-1" FACE = "Arial, Helvetica">
				Available Payment Methods:
				</FONT>
			</TD><TD WIDTH = "100%">
				<TABLE BORDER = 0>
					<MvASSIGN NAME = "l.col" VALUE = 1>

					<TR>
					<MvASSIGN NAME = "l.method" VALUE = 1>
					<MvWHILE EXPR = "{ l.method LE g.Store_PlugNPay_Method_Count }">
						<MvASSIGN NAME = "l.method_code" VALUE = "{ g.Store_PlugNPay_Method_Code_&[ l.method ] }">
						<MvASSIGN NAME = "l.method_name" VALUE = "{ g.Store_PlugNPay_Method_Name_&[ l.method ] }">

						<MvIF EXPR = "{ l.col GT 2 }">
							<MvASSIGN NAME = "l.col" VALUE = 1>
							</TR><TR>
						</MvIF>

						<TD ALIGN = "left" VALIGN = "middle" NOWRAP>
							<FONT SIZE = "-1" FACE = "Arial, Helvetica">
							<INPUT TYPE = "hidden" NAME = "Store_PlugNPay_Method_Code_&[ l.method ]" VALUE = "&[ l.method_code:entities ]">
							<INPUT TYPE = "hidden" NAME = "Store_PlugNPay_Method_Name_&[ l.method ]" VALUE = "&[ l.method_name:entities ]">
							<MvIF EXPR = "{ g.Store_PlugNPay_Method_Enabled_&[ l.method ] }">
								<INPUT TYPE = "checkbox" NAME = "Store_PlugNPay_Method_Enabled_&[ l.method ]" VALUE = "Yes" CHECKED>
							<MvELSE>
								<INPUT TYPE = "checkbox" NAME = "Store_PlugNPay_Method_Enabled_&[ l.method ]" VALUE = "Yes">
							</MvIF>

							<MvEVAL EXPR = "{ l.method_name }">
							</FONT>
						</TD>

						<MvASSIGN NAME = "l.col" VALUE = "{ l.col + 1 }">
						<MvASSIGN NAME = "l.method" VALUE = "{ l.method + 1 }">
					</MvWHILE>

					<MvIF EXPR = "{ l.col LE 2 }">
						</TR>
					</MvIF>
				</TABLE>

				<INPUT TYPE = "hidden" NAME = "Store_PlugNPay_Method_Count" VALUE = "&[ g.Store_PlugNPay_Method_Count:entities ]">
			</TD></TR>
			</TABLE>
		<MvELSE>
			<INPUT TYPE = "hidden" NAME = "Store_PlugNPay_merchant" VALUE = "&[ g.Store_PlugNPay_merchant:entities ]">
			<INPUT TYPE = "hidden" NAME = "Store_PlugNPay_URL" VALUE = "&[ g.Store_PlugNPay_URL:entities ]">

			<MvASSIGN NAME = "l.method" VALUE = 1>
			<MvWHILE EXPR = "{ l.method LE g.Store_PlugNPay_Method_Count }">
				<MvASSIGN NAME = "l.method_code" VALUE = "{ g.Store_PlugNPay_Method_Code_&[ l.method ] }">
				<MvASSIGN NAME = "l.method_name" VALUE = "{ g.Store_PlugNPay_Method_Name_&[ l.method ] }">
				<MvASSIGN NAME = "l.method_enabled" VALUE = "{ g.Store_PlugNPay_Method_Enabled_&[ l.method ] }">

				<INPUT TYPE = "hidden" NAME = "Store_PlugNPay_Method_Code_&[ l.method ]" VALUE = "&[ l.method_code:entities ]">
				<INPUT TYPE = "hidden" NAME = "Store_PlugNPay_Method_Name_&[ l.method ]" VALUE = "&[ l.method_name:entities ]">
				<INPUT TYPE = "hidden" NAME = "Store_PlugNPay_Method_Enabled_&[ l.method ]" VALUE = "&[ l.method_enabled:entities ]">

				<MvASSIGN NAME = "l.method" VALUE = "{ l.method + 1 }">
			</MvWHILE>

			<INPUT TYPE = "hidden" NAME = "Store_PlugNPay_Method_Count" VALUE = "&[ g.Store_PlugNPay_Method_Count:entities ]">

		</MvIF>
	</MvIF>

	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Order_Validate" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Order_Update" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = 1>
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Order_Delete" STANDARDOUTPUTLEVEL = "">
	<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">
	<MvIF EXPR = "{ l.ok }">
		<MvFIND NAME = "PlugNPayOrders" VALUE = "{ Orders.d.id }" EXACT>
		<MvIF EXPR = "{ NOT PlugNPayOrders.d.EOF }">
			<MvDELETE NAME = "PlugNPayOrders">
		</MvIF>

		<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.ok }">
</MvFUNCTION>

<MvFUNCTION NAME = "PaymentModule_Order_Tabs" STANDARDOUTPUTLEVEL = "">
	<MvFUNCTIONRETURN VALUE = "PLUGNPAY:Plug & Pay Technologies Inc. v1.0">
</MvFUNCTION>


<MvFUNCTION NAME = "PaymentModule_Order_Content" PARAMETERS = "tab, load_fields" STANDARDOUTPUTLEVEL = "text, html, compresswhitespace">
	<MvASSIGN NAME = "l.ok" VALUE = 1>

	<MvIF EXPR = "{ l.tab EQ 'PLUGNPAY' }">
		<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Open_Store() }">
		<MvIF EXPR = "{ l.ok }">
			<MvFIND NAME = "PlugNPayOrders" VALUE = "{ Orders.d.id }" EXACT>
			<MvIF EXPR = "{ NOT PlugNPayOrders.d.EOF }">
				<TABLE BORDER = 0 CELLPADDING = 2 CELLSPACING = 0 WIDTH = "100%">

				<TR><TD NOWRAP>
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<B>Method:</B>
					</FONT>
				</TD><TD WIDTH = "100%">
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<MvEVAL EXPR = "{ PlugNPayOrders.d.method }">
					</FONT>
				</TD></TR>

				<MvIF EXPR = "{ PlugNPayOrders.d.method EQ 'CC' }">
					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Name on Card:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.name  }">
						</FONT>
					</TD></TR>

					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Card Number:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.card_num }">
						</FONT>
					</TD></TR>

					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Expiration:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.exp_date }">
						</FONT>
					</TD></TR>

					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>AVS Code:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.avs_code }">
						</FONT>
					</TD></TR>
				<MvELSE>
					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Bank Name:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.bank_name }">
						</FONT>
					</TD></TR>

					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Bank ABA Code:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.aba_code }">
						</FONT>
					</TD></TR>

					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Account Number:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.acct_num }">
						</FONT>
					</TD></TR>

					<TR><TD NOWRAP>
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<B>Account Type:</B>
						</FONT>
					</TD><TD WIDTH = "100%">
						<FONT FACE = "Arial, Helvetica" SIZE = "-1">
						<MvEVAL EXPR = "{ PlugNPayOrders.d.acct_type }">
						</FONT>
					</TD></TR>
				</MvIF>

				<TR><TD NOWRAP>
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<B>Transaction ID:</B>
					</FONT>
				</TD><TD WIDTH = "100%">
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<MvEVAL EXPR = "{ PlugNPayOrders.d.trans_id }">
					</FONT>
				</TD></TR>

				<TR><TD NOWRAP>
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<B>Response Reason Text:</B>
					</FONT>
				</TD><TD WIDTH = "100%">
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<MvEVAL EXPR = "{ PlugNPayOrders.d.r_r_text }">
					</FONT>
				</TD></TR>

				<TR><TD NOWRAP>
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<B>Authorization Code:</B>
					</FONT>
				</TD><TD WIDTH = "100%">
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<MvEVAL EXPR = "{ PlugNPayOrders.d.auth_code }">
					</FONT>
				</TD></TR>

				<TR><TD NOWRAP>
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<B>Authorization Date & Time:</B>
					</FONT>
				</TD><TD WIDTH = "100%">
					<FONT FACE = "Arial, Helvetica" SIZE = "-1">
					<MvEVAL EXPR = "{ padl( time_t_month( PlugNPayOrders.d.time, timezone() ), 2, '0') $ '/' $ padl( time_t_dayofmonth( PlugNPayOrders.d.time, timezone() ), 2, '0')
									$ '/' $ time_t_year( PlugNPayOrders.d.time, timezone() ) $ ' - ' $ padl( time_t_hour( PlugNPayOrders.d.time, timezone() ), 2, '0' )
									$ ':' $ padl( time_t_min( PlugNPayOrders.d.time, timezone() ), 2, '0' ) $ ':' $ padl( time_t_sec( PlugNPayOrders.d.time, timezone() ), 2, '0' )
									$ ' ' $ stm_zone }">
					</FONT>
				</TD></TR>
				</TABLE>

			</MvIF>

			<MvASSIGN NAME = "l.ok" VALUE = "{ PlugNPay_Close_Store() }">
		</MvIF>
	</MvIF>

	<MvFUNCTIONRETURN VALUE = "{ l.ok }">
</MvFUNCTION>

